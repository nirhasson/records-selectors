{
  "trailingSlash": false,
  "functions": {
    "api/page.js": { "includeFiles": "data/**" }
  },
  "rewrites": [
    { "source": "/album/:slug", "destination": "/api/page?type=album&slug=:slug" },
    { "source": "/genre/:genre", "destination": "/api/page?type=genre&genre=:genre" },
    { "source": "/genre/:genre/page/:page", "destination": "/api/page?type=genre&genre=:genre&page=:page" },
    { "source": "/picks", "destination": "/api/page?type=picks" },
    { "source": "/picks/:slug", "destination": "/api/page?type=picks&slug=:slug" },
    { "source": "/magazine", "destination": "/api/page?type=magazine" },
    { "source": "/magazine/:slug", "destination": "/api/page?type=magazine&slug=:slug" }
  ]
}
